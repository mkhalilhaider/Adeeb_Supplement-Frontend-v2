# VITE_* values are bundled into the browser code — never put secrets here.

# Backend API base, no trailing slash. Local backend or production.
VITE_API_URL=http://localhost:8000/api
# VITE_API_URL=https://e-commerce-five-sigma-76.vercel.app/api

# Public address of the shop (canonical links, structured data).
VITE_SITE_URL=https://www.adeebsupplement.pk

# Show "Continue with Google" only when the backend has Google keys configured.
VITE_GOOGLE_AUTH_ENABLED=false

# Analytics (optional; leave empty to disable).
VITE_GA_ID=
VITE_META_PIXEL_ID=

# ── Server-only (Vercel functions in /api; set in Vercel project settings) ──
# API_URL=https://e-commerce-five-sigma-76.vercel.app/api
# SERPAPI_API_KEY=
