# VITE_* values are bundled into the browser code — never put secrets here.

# Backend API base, no trailing slash. Local backend or production.
VITE_API_URL=http://localhost:8000/api
# VITE_API_URL=https://e-commerce-five-sigma-76.vercel.app/api

# Public address of the shop (canonical links, structured data).
VITE_SITE_URL=https://www.adeebsupplement.pk

# Show "Continue with Google" only when the backend has Google keys configured.
VITE_GOOGLE_AUTH_ENABLED=false

# Analytics (optional; leave empty to disable).
# Google Analytics 4 measurement id (G-XXXXXXX); VITE_GA_MEASUREMENT_ID also works.
VITE_GA_ID=
VITE_META_PIXEL_ID=

# ── Server-only (Vercel functions in /api + middleware.js) ───────────────────
# Set these in Vercel → Project → Settings → Environment Variables. For local testing put
# them in .env.local (gitignored): `npm run dev` runs the /api functions with them.
#
# Backend URL for the functions (defaults to VITE_API_URL).
# API_URL=https://e-commerce-five-sigma-76.vercel.app/api
# Public site address used in previews and the sitemap (defaults to VITE_SITE_URL).
# SITE_URL=https://www.adeebsupplement.pk
#
# Live Google reviews on the homepage — one of:
#   SerpAPI (every review, paged; also accepted as SERPAPI_KEY or SERP_API_KEY)
# SERPAPI_API_KEY=
#   or Google Places API (New) — official, 5 most relevant reviews; also accepted as
#   GOOGLE_MAPS_API_KEY or GOOGLE_API_KEY
# GOOGLE_PLACES_API_KEY=
# Optional: the listing's place id (Places) / data id (SerpAPI); found automatically otherwise.
# GOOGLE_PLACE_ID=
# GOOGLE_MAPS_DATA_ID=0x3eb33f006bebfe79:0xf3122b83a6454335
#
# Optional extra lock on /admin ("user:password"); leave unset to disable.
# ADMIN_BASIC_AUTH=
